# Copy to .env on the deployment host. Replace every CHANGE_ME value.
DEBUG=0
ENV_TYPE=PROD
DB_TYPE=postgres
DB_ENGINE=django.contrib.gis.db.backends.postgis
DJANGO_ALLOWED_HOSTS=CHANGE_ME_HOSTNAME CHANGE_ME_IP localhost 127.0.0.1
SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE
SENTRY_ENABLED=0
SENTRY_DSN=

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DBNAME=oss_ldms
POSTGRES_USER=ldms_user
POSTGRES_PASS=CHANGE_ME_DATABASE_PASSWORD
REDIS_HOST=redis
QUEUED_JOB_TIMEOUT=7200

# Application visibility. When filtering is enabled, use the exact country
# format from the production environment.
FILTER_COUNTRIES=0
PUBLISHED_COUNTRIES=

MISLAND_MEDIA_PATH=/data/misland-media
FRONTEND_PORT=80
BACKEND_PORT=1337
PUBLIC_API_BASE_URL=/
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=7200

GEOSERVER_HOST_PRIVATE=http://geoserver-gateway
GEOSERVER_HOST_PUBLIC=CHANGE_ME_PUBLIC_GEOSERVER_URL
GEOSERVER_PORT=8600
GEOSERVER_DATA_PATH=/data/misland-geoserver
GEOSERVER_DATA_DIR=/opt/geoserver/data_dir
GEOWEBCACHE_CACHE_DIR=/opt/geoserver/data_dir/gwc
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=CHANGE_ME_GEOSERVER_PASSWORD
GEOSERVER_IGNORE_PRIVATE_HOST=0
RESET_ADMIN_CREDENTIALS=false
INITIAL_MEMORY=2G
MAXIMUM_MEMORY=4G
INITIAL_HEAP_OCCUPANCY_PERCENT=45
DISABLE_WEB_INTERFACE=true
ROOT_WEBAPP_REDIRECT=true
TOMCAT_EXTRAS=false
PUID=1000
PGID=1000

# Optional URL rewriting and diagnostic logging.
RETURN_URL_MAP_FILE=
LOGFILE=logs/main.log
ERROR_LOGFILE=logs/error.log
MEMORY_PROFILER_LOG_FILE=logs/memory-profiler.log
USE_LOG_FILE=1

# Google Earth Engine. The credential file must exist inside the backend image
# at the configured path. The current backend source includes
# gee_private_key.json, but that credential should be replaced and rotated.
GOOGLE_SERVICE_ACCOUNT=
GOOGLE_PRIVATE_KEY_FILE=/home/app/web/gee_private_key.json
GOOGLE_APPLICATION_CREDENTIALS=/home/app/web/gee_private_key.json

# Firebase and push notifications are optional. Keep them disabled unless the
# production application actively uses them and valid credentials are supplied.
ENABLE_PUSH_NOTIFICATIONS=0
FIREBASE_APPLICATION_CREDENTIALS=
FCM_API_KEY=
GCM_API_KEY=
APNS_CERTIFICATE=

# The backup service is disabled unless the backup profile is selected.
DB_BACKUP_PATH=/data/misland-db-backups
DUMPPREFIX=PG_oss_ldms
CRON_SCHEDULE=0 2 * * *
REMOVE_BEFORE=30

# Mail server settings are primarily stored in the application's database by
# the communication module, rather than in this environment file.

# Frontend build-time configuration. MAPBOX_ACCESS_TOKEN must be a public
# browser token. CONTACT_FORM_ENDPOINT must be a server-side endpoint that
# creates contact requests without exposing a GitHub credential to browsers.
MAPBOX_ACCESS_TOKEN=
CONTACT_FORM_ENDPOINT=
